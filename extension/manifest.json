{
  "manifest_version": 3,
  "name": "StepSnap - Click Recorder & Guide Maker",
  "version": "1.0.0",
  "description": "Record clicks and typing, get a step-by-step guide with screenshots and a PDF. No sign-in.",
  "permissions": ["storage", "unlimitedStorage", "tabs", "activeTab", "scripting"],
  "host_permissions": ["<all_urls>"],
  "background": { "service_worker": "background.js" },
  "action": { "default_popup": "popup.html", "default_title": "StepSnap" },
  "content_scripts": [{ "matches": ["<all_urls>"], "js": ["content.js"], "run_at": "document_start", "all_frames": true, "match_about_blank": true }],
  "icons": { "16": "icon16.png", "48": "icon48.png", "128": "icon128.png" }
}
